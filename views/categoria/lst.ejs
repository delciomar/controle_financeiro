<%- include('../cabecalho')%>
<div>
    <h3>Categorias</h3>
    <a href="/categoria/add">+ Nova Categoria</a><br><br>

    <table>
        <tr>
            <td>
                <h3>Nome</h3>
            </td>
            <td>
                <h3>Tipo</h3>
            </td>
            <td>
                <h3>Descrição</h3>
            </td>
            <td>
                <h3>Ação </h3>
            </td>
        </tr>
        <%categorias.forEach(categoria=>{%>
            <tr>
                <td>
                    <%=categoria.nome%>
                </td>
                <td>
                    <%=categoria.tipo%>
                </td>
                <td>
                    <%=categoria.descricao%>
                </td>
                <td>
                    <a href="/categoria/upd/<%=categoria.id%>">✏️</a>
                    <a href="/categoria/del/<%=categoria.id%>">🗑️</a>
                </td>
            </tr>
            <%})%>
    </table>
    </div>
    </body>

    </html>