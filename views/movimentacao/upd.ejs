<%- include('../cabecalho')%>


    <div>
        <tr><a href="/movimentacao"> ← Voltar </a></tr>
        <h3>Alterar Movimentação</h3>


        <form method="post">
            <p>ID</p>
            <input type="text" name="id" value="<%=movimentacao.id%>" readonly>
            <br>
            <p>Nome</p>
            <input type="text" name="nome" value="<%=movimentacao.nome%>">
            <br>
            <p>Descrição</p>
            <input type="text" name="descricao" value="<%=movimentacao.descricao%>">
            <br>
            <p>Valor</p>
            <input name="valor" type="number" value="<%=movimentacao.valor%>">
            <br>
            <p>Data</p>
            <input name="data" type="date" value="<%=movimentacao.data%>">
            <br>
            <p>Tipo</p>
            <input name="tipo" type="text" value="<%=movimentacao.tipo%>">
            <br><br>
            <button type="submit">Salvar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>